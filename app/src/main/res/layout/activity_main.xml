<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondo_login"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor"

        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="30dp"
        app:cardMaxElevation="35dp"
        app:cardCornerRadius="25dp">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="293dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio de sesion"
            android:textColor="#FF6347"
            android:textSize="30sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etCorreo"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_imput"
            android:drawableStart="@drawable/EMail"
            android:drawablePadding="10dp"
            android:hint="Correo electronico"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:paddingEnd="15dp"
            android:textColorHint="#FFCDBF"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="392dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_imput"
            android:drawableStart="@drawable/pass"
            android:drawablePadding="10dp"
            android:hint="Contraseña"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:paddingEnd="15dp"
            android:textColorHint="#FFCDBF"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="468dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIngresar"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_botton"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="542dp"
            android:text="INGRESAR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Crea una cuenta ->"
            android:textColor="#0d8f20"
            android:textStyle="bold"
            tools:layout_editor_absoluteX="145dp"
            tools:layout_editor_absoluteY="613dp" />
    </LinearLayout>

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>